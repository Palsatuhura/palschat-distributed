# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=

# Redis connection string. Use rediss:// (two s) for remote hosts such as Upstash.
REDIS_URL=

# Secret used to sign login tokens. The server refuses to start if it is
# shorter than 32 characters or looks like a placeholder.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Every backend instance (server1, server2, ...) MUST use the SAME value,
# otherwise a token issued by one server is rejected by the other.
JWT_SECRET=

# How long a login token stays valid. Default 24h. Use a number plus s, m, h,
# d or w (30m, 12h, 1d), or a plain number of seconds. Minimum 10s.
# While someone keeps using the app, it quietly asks for a fresh token when this
# one is half used up. When it runs out unused, the app signs the user out and
# says why. Handy for a demo: JWT_EXPIRES_IN=2m
# JWT_EXPIRES_IN=24h

# Longest a login can last, however often it is renewed, in days (1 to 365).
# Each login is a "session" the user can see and end under Password and
# devices. Signing out, removing a device or changing the password ends it at
# once, on every server.
# SESSION_MAX_DAYS=30

# Browser origins allowed to call the API, comma separated, no trailing slash.
# Default (if unset): http://localhost:5173, :5174 and :3000
# CORS_ORIGINS=https://chat.example.com

# Number of reverse proxies / load balancers in front of the app. Leave unset
# when clients connect directly (local development). Never set it to "true".
#   Too low  -> every user looks like the proxy and they all share one
#               rate-limit budget.
#   Too high -> clients can fake their IP with an X-Forwarded-For header.
# On a hosting platform, MEASURE it (hosts do not all document the number):
#   1. Set DEBUG_CLIENT_IP=true and TRUST_PROXY=1, deploy.
#   2. Open https://<your-app>/api/debug/client-ip from your own network.
#      "ip" should equal your public IP (look it up on any what-is-my-ip site).
#      If not, raise TRUST_PROXY by one and redeploy; repeat.
#   3. Spoof test:  curl -H "X-Forwarded-For: 9.9.9.9" https://<your-app>/api/debug/client-ip
#      "ip" must STILL be your real IP. If it shows 9.9.9.9, TRUST_PROXY is
#      too high.
#   4. Remove DEBUG_CLIENT_IP again.
# TRUST_PROXY=1

# Temporary diagnostic for the TRUST_PROXY measurement above. Keep it off.
# DEBUG_CLIENT_IP=true

# Optional rate-limit overrides
# RATE_LIMIT_LOGIN_IP_MAX=30        failed logins per IP per 15 min
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=10   failed logins per account per 15 min
# RATE_LIMIT_REGISTER_MAX=10        registration attempts per IP per hour (failed
#                                   attempts count too). For development with
#                                   npm run check:authz / check:hardening use 50.
# RATE_LIMIT_API_MAX=300            API requests per IP per minute

# Presence (the green "online" dots). Defaults suit most setups.
# Every Redis command counts against hosted free-tier quotas (e.g. Upstash),
# so shorter intervals use more of it.
# PRESENCE_HEARTBEAT_MS=30000   each server renews its sockets this often
# PRESENCE_TTL_MS=90000         an entry nobody renews counts as gone after this
# PRESENCE_SWEEP_MS=60000       how often servers clean up after dead servers
# PRESENCE_GRACE_MS=3000        wait before announcing "offline" (page refresh)
# PRESENCE_COMMAND_TIMEOUT_MS=3000   give up on a Redis presence call after this

# --- Forgot password (email through Brevo, free plan) ---
# Leave these out and the "forgot password" link simply sends no email.
# APP_URL is the address of the website, used inside the reset link.
APP_URL=http://localhost:5173
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=PalsChat
