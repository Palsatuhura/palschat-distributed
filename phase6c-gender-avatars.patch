diff --git a/frontend/src/lib/gender.js b/frontend/src/lib/gender.js
new file mode 100644
index 0000000..80ff00e
--- /dev/null
+++ b/frontend/src/lib/gender.js
@@ -0,0 +1,17 @@
+/** The choices offered at signup and in the profile. */
+export const GENDER_CHOICES = [
+  { value: "male", label: "Male" },
+  { value: "female", label: "Female" },
+  { value: "unspecified", label: "Prefer not to say" },
+];
+
+export const isGender = (v) => GENDER_CHOICES.some((c) => c.value === v);
+
+/** Anything unexpected (old accounts, missing field) counts as unspecified. */
+export const genderOf = (user) => (isGender(user?.gender) ? user.gender : "unspecified");
+
+/**
+ * Which default picture to draw when someone has not uploaded one.
+ * Deleted users always get the neutral icon.
+ */
+export const defaultAvatarKind = (user) => (user?.deletedAt ? "unspecified" : genderOf(user));
diff --git a/frontend/src/lib/gender.test.js b/frontend/src/lib/gender.test.js
new file mode 100644
index 0000000..92aec22
--- /dev/null
+++ b/frontend/src/lib/gender.test.js
@@ -0,0 +1,18 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { genderOf, defaultAvatarKind, isGender } from "./gender.js";
+
+test("genderOf falls back to unspecified", () => {
+  assert.equal(genderOf({ gender: "male" }), "male");
+  assert.equal(genderOf({ gender: "female" }), "female");
+  assert.equal(genderOf({}), "unspecified");
+  assert.equal(genderOf(null), "unspecified");
+  assert.equal(genderOf({ gender: "robot" }), "unspecified");
+  assert.equal(isGender("male"), true);
+  assert.equal(isGender("x"), false);
+});
+
+test("deleted users get the neutral icon", () => {
+  assert.equal(defaultAvatarKind({ gender: "female", deletedAt: "2026-01-01" }), "unspecified");
+  assert.equal(defaultAvatarKind({ gender: "female" }), "female");
+});
